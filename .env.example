# Copy this file to `.env` and fill in values. `.env` is gitignored and
# excluded from Docker images. Never commit a real key.

# Anthropic API key, used for Oshi's live narration and the intervention
# picker (both call Claude Haiku).
# Leave it empty to run fully offline: Oshi then uses its scripted lines.
ANTHROPIC_API_KEY=""

# Port note: the app does NOT read this variable. The port is set on the
# command line (`uvicorn ... --port 8000`) and fixed at 8000 in the Dockerfile.
# PORT=8000
